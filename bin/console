#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'
require 'speedy'

# You can add fixtures and/or initialization code here to make experimenting
# with your gem easier. You can also use a different console, if you like.

Speedy::Client.configure do |config|
  config.username = SPEEDY_USERNAME
  config.password = SPEEDY_PASSWORD
  config.language = ENV.fetch('SPEEDY_LANGUAGE', 'BG')
  config.client_system_id = SPEEDY_CLIENT_SYSTEM_ID.to_i
  config.debug = true
end
require 'irb'
IRB.start(__FILE__)
